{
  "schemaVersion": 1,
  "id": "simplefinances",
  "version": "${version}",
  "name": "Simple Finances",
  "description": "Простая экономика: монеты, кошелёк, переводы, биомные монеты, общая коллекция и админ-панель.",
  "authors": [
    "Simple Finances"
  ],
  "license": "MIT",
  "icon": "assets/simplefinances/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.simplefinances.SimpleFinances"
    ],
    "client": [
      "com.simplefinances.client.SimpleFinancesClient"
    ]
  },
  "mixins": [
    "simplefinances.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*"
  }
}
